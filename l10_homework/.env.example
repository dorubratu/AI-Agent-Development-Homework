# L10 foloseste config-ul LLM/DB din ../l6_homework/.env (incarcat automat).
# Acest fisier suprascrie/adauga doar setari specifice L10.

# Activeaza stratul LLM-as-Judge in guardrail (in plus fata de regex).
# 0 = doar regex (default, fara cost), 1 = regex + LLM-as-Judge.
GUARDRAIL_LLM_JUDGE=0

# Optional: daca vrei sa rulezi independent de l6_homework/.env, seteaza aici:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# DATABASE_URL=postgresql://demo:demo123@localhost:5433/rag_demo
